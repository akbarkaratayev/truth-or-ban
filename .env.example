# Token from @BotFather
BOT_TOKEN=

# How often (in hours) the bot asks a random member a question
QUESTION_INTERVAL_HOURS=6

# Path to the SQLite database file
DATABASE_PATH=bot.db

# Path to the newline-separated question list
QUESTIONS_FILE=questions.txt

# Only needed for scripts/import_members.py (one-off member list import).
# Get these from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
